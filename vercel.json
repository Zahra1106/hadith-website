{
  "rewrites": [
    { "source": "/css/:path*", "destination": "/public/css/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/hero-video.mp4", "destination": "/public/hero-video.mp4" },
    { "source": "/((?!api/).*)", "destination": "/public/index.html" }
  ]
}
